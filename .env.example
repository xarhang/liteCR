# Isolated local development only. Never use with patient/shared data.
# Database values match the disposable Compose example.
LITECR_DATABASE_URL=postgres://litecr:litecr-local-only@127.0.0.1:54329/litecr
LITECR_MIGRATION_DATABASE_URL=postgres://litecr:litecr-local-only@127.0.0.1:54329/litecr
LITECR_DATABASE_MAX_CONNECTIONS=10
LITECR_BIND=127.0.0.1:18080
LITECR_ENV=development
LITECR_OIDC_ISSUER_URL=http://127.0.0.1:18081/realms/litecr
LITECR_OIDC_CLIENT_ID=litecr-web
LITECR_OIDC_CLIENT_SECRET=REPLACE_WITH_LOCAL_CLIENT_SECRET
LITECR_WEB_ORIGIN=http://127.0.0.1:18080
LITECR_OIDC_REDIRECT_URI=http://127.0.0.1:18080/api/v1/access/oidc/callback
LITECR_COOKIE_SECURE=false
LITECR_SESSION_IDLE_SECONDS=900
