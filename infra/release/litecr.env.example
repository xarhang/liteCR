# Copy to /etc/litecr/litecr.env and set restrictive ownership/mode.
# Do not put these example placeholders into a running service.
# No default credentials are supplied.
# The API binds to 127.0.0.1:8080 when LITECR_BIND is omitted.
# PostgreSQL must be reachable through an approved local/private connection.
LITECR_DATABASE_URL=postgresql://REPLACE_WITH_DATABASE_CREDENTIALS@127.0.0.1/litecr
# Production must use an HTTPS origin and secure cookies.
LITECR_ENV=production
LITECR_OIDC_ISSUER_URL=https://REPLACE_WITH_EXISTING_IDP/realms/REPLACE
LITECR_OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
LITECR_OIDC_CLIENT_SECRET=REPLACE_WITH_SECRET
LITECR_WEB_ORIGIN=https://REPLACE_WITH_PUBLIC_HOST
LITECR_OIDC_REDIRECT_URI=https://REPLACE_WITH_PUBLIC_HOST/api/v1/access/oidc/callback
LITECR_COOKIE_SECURE=true
# Server-side inactivity expiry: 15 minutes by default, allowed 60–1800 seconds.
# Absolute lifetime is separate (default 28800 seconds / 8 hours).
LITECR_SESSION_IDLE_SECONDS=900
# Optional: LITECR_BIND=127.0.0.1:8080
# Optional: LITECR_DATABASE_MAX_CONNECTIONS=10
# Optional: LITECR_FHIR_CLIENT_BINDINGS=<protected-json-client-binding-map>
# Optional API matching active evaluations per store; default remains 2 (or less for a small pool).
# Pool 10 allows 1..8. Keep bounded admission128/wait30s; no unlimited mode.
# Measure workload and API responsiveness before raising; worker budgets are separate.
# LITECR_MATCHING_PARALLELISM=4
