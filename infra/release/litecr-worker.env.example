# Copy to /etc/litecr/worker.env, owned by root:litecr-worker, mode 0640.
# This is a dedicated worker identity. Do not copy the API or migration URL.
# A tested least-privilege worker grant procedure exists, but production and
# clean-host readiness gates remain open. Do not populate this or create
# /etc/litecr/worker.enable until the release contract gates are accepted.
LITECR_WORKER_DATABASE_URL=

# Optional stable node label; the process ID is appended at runtime.
LITECR_WORKER_ID=litecr-worker-node
